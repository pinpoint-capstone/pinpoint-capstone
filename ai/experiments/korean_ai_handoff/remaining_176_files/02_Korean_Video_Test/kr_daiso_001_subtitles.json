[
  {
    "start_time": 0.0,
    "end_time": 2.08,
    "text": "팅으로 잘 썼던 다이소 상반기 결산템디"
  },
  {
    "start_time": 2.08,
    "end_time": 3.08,
    "text": "빠르게 소개해 드릴게요"
  },
  {
    "start_time": 3.08,
    "end_time": 4.68,
    "text": "여행 갈 때 무조건 챙기는 파우치"
  },
  {
    "start_time": 4.68,
    "end_time": 7.28,
    "text": "화장품 진짜 많아서 파우치 두세 개씩 챙겼었는데"
  },
  {
    "start_time": 7.28,
    "end_time": 8.4,
    "text": "이제 이거 하나는 끝이에요"
  },
  {
    "start_time": 8.4,
    "end_time": 10.0,
    "text": "고기 먹을 때 필수인 양념세트"
  },
  {
    "start_time": 10.0,
    "end_time": 11.36,
    "text": "참기름, 소금, 쌈장"
  },
  {
    "start_time": 11.36,
    "end_time": 13.72,
    "text": "쭈왕까지 수량씩 들어있어서 먹기 너무 편해요"
  },
  {
    "start_time": 13.72,
    "end_time": 15.16,
    "text": "빨리 편하게 해주는 시트 세제"
  },
  {
    "start_time": 15.16,
    "end_time": 17.08,
    "text": "톡 뜯어 여행 갈 때 들고 가기도 좋고"
  },
  {
    "start_time": 17.08,
    "end_time": 19.08,
    "text": "섬유인지 안 넣어도 향기가 대박이에요"
  },
  {
    "start_time": 19.08,
    "end_time": 20.6,
    "text": "피랑 진짜 비슷한 젤리판"
  },
  {
    "start_time": 20.6,
    "end_time": 22.68,
    "text": "다이소 립 중에는 제일 잘 쓰게 되더라고요"
  },
  {
    "start_time": 22.68,
    "end_time": 24.48,
    "text": "탱글티즈랑 비슷한 비슷한 요거 두 개"
  },
  {
    "start_time": 24.48,
    "end_time": 26.8,
    "text": "현상모듣게 잘 빗겨서 여행 갈 때 꼭 챙겨가요"
  },
  {
    "start_time": 26.8,
    "end_time": 29.0,
    "text": "집에 두면 한층 더 귀여워지는 인테리어템"
  },
  {
    "start_time": 29.0,
    "end_time": 30.08,
    "text": "저소음이라 더 좋고"
  },
  {
    "start_time": 30.08,
    "end_time": 31.08,
    "text": "어디도 더 잘 어울려서"
  },
  {
    "start_time": 31.08,
    "end_time": 32.08,
    "text": "이건 진짜 잘 썬데"
  }
]