cat > backend/.env.example << 'EOF'
# 필수
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
YOUTUBE_API_KEY=

# AI 사용 여부: 1이면 실제 모델, 0이면 가짜 결과(stub)로 동작
USE_REAL_AI=1

# 한국어 자막 검색용 MiniLM(final_model) 폴더의 절대 경로
PINPOINT_MINILM_MODEL_PATH=

# 선택
# 프론트 주소 허용 목록 (쉼표로 구분). 기본값: localhost/127.0.0.1의 3000, 5173
CORS_ORIGINS=
# 자막 검색을 인정하는 최소 유사도(0~1). 기본값 0.35
SUBTITLE_MIN_SCORE=0.35
EOF# 선택: 검색어 번역 모델 (기본 NLLB 2.4GB, 가벼운 모델은 Helsinki-NLP/opus-mt-ko-en)
TRANSLATE_MODEL=facebook/nllb-200-distilled-600M
# 선택: 자막 구간 보정 (시작 앞당김 초, 최소 길이 초)
SUBTITLE_PAD_BEFORE=2.0
SUBTITLE_MIN_LEN=6.0
